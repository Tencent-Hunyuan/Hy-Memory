{
  "name": "@one-memory/runtime-control",
  "version": "1.0.3",
  "private": true,
  "type": "module",
  "bin": {
    "one-memory-runtime": "dist/runtime.cjs"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsup && node ../../scripts/build_runtime_native.cjs",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "node ../../scripts/assert-test-isolation.mjs && vitest run"
  },
  "dependencies": {
    "@one-memory/contracts": "workspace:*",
    "@one-memory/host-bridge": "workspace:*",
    "axios": "^1.20.0",
    "fflate": "0.8.3",
    "https-proxy-agent": "7.0.0",
    "proxy-from-env": "2.1.0",
    "tar": "7.5.22"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
