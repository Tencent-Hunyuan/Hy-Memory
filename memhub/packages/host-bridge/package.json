{
  "name": "@one-memory/host-bridge",
  "version": "1.0.4",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./installer": "./src/recall-installer.ts"
  },
  "scripts": {
    "build": "tsup && node scripts/build-hook-assets.mjs && node scripts/build-hermes-provider-assets.mjs",
    "build:sync-hook": "node scripts/build-hook-assets.mjs",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "node ../../scripts/assert-test-isolation.mjs && pnpm build && vitest run --maxWorkers=1"
  },
  "dependencies": {
    "@one-memory/contracts": "workspace:*",
    "axios": "^1.20.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
